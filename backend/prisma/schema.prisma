generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Department {
  it
  fa
  exim
  hrd
  rnd
  lab
  ppic
  iso
  produksi
  marketing
  teknik
}

enum Kategori {
  komputer
  laptop
  ups
  printer
  monitor
  mouse
  keyboard
  scanner
  stavolt
  memory
  storage
  license
  sparepart
  cctv
  lain_lain
}

enum StatusBarang {
  aktif
  tidak_aktif
  sedang_service
  rusak
  dijual
}

enum JenisMutasi {
  pembelian
  penjualan
  perpindahan
}

model User {
  id            Int        @id @default(autoincrement())
  username      String     @unique
  password      String
  rememberToken String?    @map("remember_token")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  userRoles     UserRole[]

  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Pemakai {
  id               Int               @id @default(autoincrement())
  nama             String            @db.VarChar(50)
  department       Department
  status           Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  barangs          Barang[]
  services         Service[]
  serviceInternals ServiceInternal[]

  @@map("m_pemakais")
}

model Barang {
  id               Int               @id @default(autoincrement())
  mPemakaiId       Int?              @map("m_pemakai_id")
  kodeBarang       String            @unique @map("kode_barang") @db.VarChar(10)
  namaBarang       String            @map("nama_barang")
  serialNumber     String?           @unique @map("serial_number") @db.VarChar(50)
  kategori         Kategori
  keterangan       String?           @db.Text
  status           StatusBarang      @default(aktif)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  pemakai          Pemakai?          @relation(fields: [mPemakaiId], references: [id])
  dtMutasis        DtMutasi[]
  services         Service[]
  serviceInternals ServiceInternal[]
  maintenances     Maintenance[]

  @@map("m_barangs")
}

model Supplier {
  id           Int        @id @default(autoincrement())
  namaSupplier String     @map("nama_supplier") @db.VarChar(50)
  alamat       String     @db.VarChar(100)
  noTelp       String?    @unique @map("no_telp") @db.VarChar(20)
  email        String?    @unique
  cp           String?    @db.VarChar(50)
  noHp         String?    @map("no_hp") @db.VarChar(20)
  keterangan   String?    @db.Text
  status       Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  mtMutasis    MtMutasi[]

  @@map("m_suppliers")
}

model ServiceCenter {
  id          Int       @id @default(autoincrement())
  namaService String    @map("nama_service") @db.VarChar(50)
  noTelp      String    @unique @map("no_telp") @db.VarChar(20)
  alamat      String    @db.VarChar(100)
  cp          String?   @db.VarChar(50)
  noHp        String?   @map("no_hp") @db.VarChar(20)
  keterangan  String?   @db.Text
  status      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  services    Service[]

  @@map("m_service_centers")
}

model MtMutasi {
  id          Int         @id @default(autoincrement())
  noMutasi    String      @unique @map("no_mutasi") @db.VarChar(12)
  mSupplierId Int?        @map("m_supplier_id")
  jenisMutasi JenisMutasi @default(pembelian) @map("jenis_mutasi")
  tglMutasi   DateTime    @map("tgl_mutasi") @db.Date
  keterangan  String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  supplier    Supplier?   @relation(fields: [mSupplierId], references: [id])
  dtMutasis   DtMutasi[]

  @@map("mt_mutasis")
}

model DtMutasi {
  id          Int      @id @default(autoincrement())
  mtMutasiId  Int      @map("mt_mutasi_id")
  pemakaiLama Int      @map("pemakai_lama")
  mBarangId   Int      @map("m_barang_id")
  pemakaiBaru Int?     @map("pemakai_baru")
  harga       BigInt?  @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  mtMutasi    MtMutasi @relation(fields: [mtMutasiId], references: [id], onDelete: Cascade)
  barang      Barang   @relation(fields: [mBarangId], references: [id])

  @@map("dt_mutasis")
}

model Service {
  id               Int           @id @default(autoincrement())
  noSj             String?       @map("no_sj")
  mPemakaiId       Int           @map("m_pemakai_id")
  mBarangId        Int           @map("m_barang_id")
  mServiceCenterId Int           @map("m_service_center_id")
  tglService       DateTime      @map("tgl_service") @db.Date
  tglSelesai       DateTime?     @map("tgl_selesai") @db.Date
  biaya            BigInt?       @default(0)
  kerusakan        String?       @db.Text
  analisa          String?       @db.Text
  solusi           String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  pemakai          Pemakai       @relation(fields: [mPemakaiId], references: [id])
  barang           Barang        @relation(fields: [mBarangId], references: [id])
  serviceCenter    ServiceCenter @relation(fields: [mServiceCenterId], references: [id])

  @@map("m_services")
}

model ServiceInternal {
  id         Int       @id @default(autoincrement())
  tglService DateTime  @map("tgl_service") @db.Date
  tglSelesai DateTime? @map("tgl_selesai") @db.Date
  mPemakaiId Int       @map("m_pemakai_id")
  mBarangId  Int       @map("m_barang_id")
  kerusakan  String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  pemakai    Pemakai   @relation(fields: [mPemakaiId], references: [id])
  barang     Barang    @relation(fields: [mBarangId], references: [id])

  @@map("m_service_internals")
}

model Maintenance {
  id            Int       @id @default(autoincrement())
  mBarangId     Int?      @map("m_barang_id")
  scheduledDate DateTime? @map("scheduled_date") @db.Date
  notes         String?   @db.Text
  status        Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  barang        Barang?   @relation(fields: [mBarangId], references: [id])

  @@map("maintenances")
}
